# ── Database (Drizzle / postgres-js) ──
# Supabase: Project Settings → Database → Connection string (use the pooled
# "Transaction" URL for the app; the direct URL for migrations if needed).
DATABASE_URL=postgres://postgres:password@localhost:5432/postgres

# ── Supabase ──
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Never expose to the client. Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── App ──
# Absolute origin used to build OAuth / magic-link / reset callback URLs.
# Must match a Redirect URL allow-listed in Supabase → Authentication → URL
# Configuration. Leave unset locally to default to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── File uploads (Cloudinary, optional until file fields ship) ──
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
