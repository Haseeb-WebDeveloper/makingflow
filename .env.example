# ── Database (Drizzle / postgres-js) ──
# Supabase: Project Settings → Database → Connection string (use the pooled
# "Transaction" URL for the app; the direct URL for migrations if needed).
DATABASE_URL=postgres://postgres:password@localhost:5432/postgres

# ── Supabase ──
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Never expose to the client. Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── App ──
# Absolute origin used to build OAuth / magic-link / reset callback URLs.
# Must match a Redirect URL allow-listed in Supabase → Authentication → URL
# Configuration. Leave unset locally to default to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── AI (Google Gemini) ──
# Server-only — never expose to the client. Powers form generation, edit-as-patch,
# plain-English logic, the conversational runtime, and submission summaries.
GEMINI_API_KEY=your-gemini-api-key

# ── File uploads (Cloudinary, optional until file fields ship) ──
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# ── Integrations: Google Sheets (OAuth) ──
# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web).
# Enable the Google Sheets API + Google Drive API, and add the redirect URI:
#   {NEXT_PUBLIC_SITE_URL}/api/integrations/google/callback
# Scope used: https://www.googleapis.com/auth/drive.file (least-privilege — the
# app only ever touches spreadsheets it created). Server-only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Encrypts stored OAuth tokens at rest (AES-256-GCM). Base64 of 32 random bytes:
#   openssl rand -base64 32
APP_ENCRYPTION_KEY=

# ── Custom domains (Vercel) ──
# Lets users serve forms from their own subdomain (forms.brand.com/your-form).
# Token: Vercel → Settings → Tokens, scoped to the team that owns the project.
# Project/Team IDs: Project → Settings → General. TEAM_ID only if team-owned.
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
# This deployment's primary host — used to tell "our" hosts (app/marketing)
# from attached custom domains. Locally use localhost:3000.
NEXT_PUBLIC_ROOT_DOMAIN=makingflow.com
