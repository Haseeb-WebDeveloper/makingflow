# Integration test environment. Committed on purpose (see .gitignore) — these
# are the throwaway credentials from docker-compose.test.yml and nothing else.
#
# tests/setup-integration.ts refuses to run unless DATABASE_URL points at
# localhost, so this file is also the guard that keeps the suite off any real
# database. Start the container with `pnpm test:db:up` first.
DATABASE_URL=postgres://makingflow_test:makingflow_test@localhost:54322/makingflow_test

# App-layer encryption key (32 bytes, base64). Used here only to derive the HMAC
# behind MCP API-key hashes in tests. NOT a secret and NOT used anywhere real:
# the value is fixed so a test's stored key hash is reproducible across runs.
# Production sets its own via the environment.
APP_ENCRYPTION_KEY=dGVzdC1vbmx5LWtleS0zMi1ieXRlcy1sb25nLTAwMDA=
